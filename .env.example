# Copy to .env and fill in real values. Never commit .env — it is gitignored.

# Postgres with the pgvector extension available.
# Local:  postgresql://postgres:postgres@localhost:5432/goodfeed
# Hosted: the connection string from Neon/Supabase
DATABASE_URL=

# Google AI Studio key (https://aistudio.google.com/apikey).
# Used for summaries, takes, topic classification, and embeddings.
GEMINI_API_KEY=

# Auth.js — generate with: npx auth secret
AUTH_SECRET=

# GitHub OAuth app credentials (https://github.com/settings/developers).
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Shared secret so the scheduled ingest endpoint rejects public calls.
CRON_SECRET=
